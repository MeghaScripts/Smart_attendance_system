# ─── MySQL ──────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1980
MYSQL_DATABASE=smart_attendance
MYSQL_POOL_SIZE=10

# ─── Main backend integration ───────────────────────────────────────────────
# Point this at stub_backend.py (http://localhost:5000) for local testing,
# or your real Flask backend in production.
BACKEND_URL=http://localhost:5000
SECRET_KEY=change-this-secret-key

# ─── Face model ──────────────────────────────────────────────────────────────
FACE_MODEL=Facenet512
FACE_DETECTOR=retinaface
FACE_DISTANCE_THRESHOLD=0.34
MATCH_MARGIN=0.04
CCTV_THRESHOLD_DELTA=0.03
PHOTO_THRESHOLD_DELTA=0.03
MATCH_TOP_K_EMBEDDINGS=3
CONFIRMATION_FRAMES=2

# ─── SVM classifier ──────────────────────────────────────────────────────────
CLASSIFIER_ENABLED=true
SVM_KERNEL=linear
SVM_C=1.0
SVM_MIN_PROBABILITY=0.55
MIN_STUDENTS_FOR_CLASSIFIER=2
AUGMENTATION_VARIANTS=12

# ─── Detection quality gates ─────────────────────────────────────────────────
MIN_DETECTION_CONFIDENCE=0.75
MIN_FACE_SIZE=45
MAX_FACE_AREA_RATIO=0.70
MIN_BLUR_VARIANCE=25.0
UPSCALE_FACTOR=2
EXPECTED_CLASS_SIZE=60

# ─── CCTV ────────────────────────────────────────────────────────────────────
RTSP_CAPTURE_WIDTH=1920
RTSP_CAPTURE_HEIGHT=1080
RTSP_BUFFER_SIZE=1
FRAME_CAPTURE_TIMEOUT_MS=2000
FRAME_CAPTURE_SLEEP_MS=10
RECOGNITION_INTERVAL=3.0
CLASS_CAMERA_MAP={"CS101": {"ip": "172.16.1.111", "http_port": 9008, "rtsp_port": 554}}

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000
